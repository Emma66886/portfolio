# Absolute base URL for metadata (Open Graph / Twitter card image URLs).
# Server-only on purpose — do NOT prefix with NEXT_PUBLIC_.
# See the "Environment" note in README.md.
SITE_URL=https://your-domain.com

# Optional: your own PeerServer for the online games (Whot, Ludo). Leave unset to use
# PeerJS's free public broker. Public on purpose: the browser connects to it.
# NEXT_PUBLIC_PEER_SERVER=https://peer.your-domain.com:443/myapp
